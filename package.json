{
  "name": "shukoi-monorepo",
  "private": true,
  "version": "1.0.4",
  "license": "MIT",
  "author": "shukoilab",
  "homepage": "https://shukoilab.github.io/shukoi/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shukoilab/shukoi.git"
  },
  "bugs": "https://github.com/shukoilab/shukoi/issues",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "NODE_OPTIONS='--expose-gc' vitest run",
    "test:ci": "NODE_OPTIONS='--expose-gc' vitest run --reporter=verbose",
    "test:qg": "NODE_OPTIONS='--expose-gc' vitest run test/qg-*.test.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "node scripts/generate-docs-spec.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "release:version": "changeset version && node scripts/sync-cli-template-versions.mjs && pnpm install --lockfile-only",
    "release:publish": "pnpm -r run build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.7",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@shukoi/api": "workspace:*",
    "@shukoi/cloudflare": "workspace:*",
    "@shukoi/core": "workspace:*",
    "@shukoi/lambda": "workspace:*",
    "@shukoi/mcp": "workspace:*",
    "@shukoi/selfhost": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "@types/node": "^22.13.4",
    "create-shukoi": "workspace:*",
    "esbuild": "^0.28.2",
    "publint": "^0.3.25",
    "taze": "^21.3.0",
    "typescript": "^5.7.3",
    "vitepress": "^1.6.4",
    "vitest": "^3.0.5"
  }
}
