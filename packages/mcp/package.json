{
  "name": "@shukoi/mcp",
  "version": "1.0.3",
  "description": "Model Context Protocol (MCP) Streamable HTTP and backpressure-safe sterile STDIO transports for Shukoi.",
  "keywords": [
    "shukoi",
    "mcp",
    "model-context-protocol",
    "llm",
    "claude",
    "cursor",
    "stdio",
    "streamable-http",
    "json-rpc",
    "ai-agent"
  ],
  "license": "MIT",
  "author": "shukoilab",
  "homepage": "https://shukoilab.github.io/shukoi/",
  "bugs": "https://github.com/shukoilab/shukoi/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shukoilab/shukoi.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./stdio": {
      "types": "./dist/stdio.d.ts",
      "import": "./dist/stdio.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shukoi/core": "workspace:*"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "hono": "^4.7.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sinclair/typebox": "^0.34.0",
    "hono": "^4.7.0"
  }
}
