{
  "name": "@shukoi/core",
  "version": "1.0.1",
  "description": "Universal action engine, adaptive TypeBox validation core, and authentication layer for the Shukoi micro-framework.",
  "keywords": [
    "shukoi",
    "action",
    "contract-first",
    "typebox",
    "validation",
    "jwt",
    "jwks",
    "crypto",
    "micro-framework",
    "idempotency"
  ],
  "license": "MIT",
  "author": "shukoilab",
  "homepage": "https://github.com/shukoilab/shukoi#readme",
  "bugs": "https://github.com/shukoilab/shukoi/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shukoilab/shukoi.git",
    "directory": "packages/core"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jose": "^5.9.6"
  },
  "peerDependencies": {
    "@sinclair/typebox": "^0.34.0"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.0"
  }
}
