{
  "name": "@shukoi/lambda",
  "version": "1.0.2",
  "description": "AWS Lambda runtime adapter with dynamic deadline calculation and early 504 timeout protection for Shukoi.",
  "keywords": [
    "shukoi",
    "aws",
    "lambda",
    "aws-lambda",
    "serverless",
    "api-gateway",
    "alb",
    "function-url"
  ],
  "license": "MIT",
  "author": "shukoilab",
  "homepage": "https://shukoilab.github.io/shukoi/",
  "bugs": "https://github.com/shukoilab/shukoi/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shukoilab/shukoi.git",
    "directory": "packages/lambda"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shukoi/core": "workspace:*"
  },
  "peerDependencies": {
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@sinclair/typebox": "^0.34.0",
    "hono": "^4.7.0"
  }
}
