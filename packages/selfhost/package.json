{
  "name": "@shukoi/selfhost",
  "version": "1.0.2",
  "description": "Standalone Bun 1.2+ and Node.js 22+ HTTP server with graceful draining state machine and Kubernetes health probes for Shukoi.",
  "keywords": [
    "shukoi",
    "bun",
    "nodejs",
    "self-host",
    "graceful-shutdown",
    "kubernetes",
    "healthz",
    "docker"
  ],
  "license": "MIT",
  "author": "shukoilab",
  "homepage": "https://github.com/shukoilab/shukoi#readme",
  "bugs": "https://github.com/shukoilab/shukoi/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shukoilab/shukoi.git",
    "directory": "packages/selfhost"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shukoi/core": "workspace:*"
  },
  "peerDependencies": {
    "@hono/node-server": "^1.13.8",
    "hono": "^4.7.0"
  },
  "peerDependenciesMeta": {
    "@hono/node-server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^1.13.8",
    "@sinclair/typebox": "^0.34.0",
    "hono": "^4.7.0"
  }
}
