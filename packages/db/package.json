{
  "name": "@shukoi/db",
  "version": "1.0.3",
  "description": "Universal modular database and transaction engine with pluggable ORM adapters (Drizzle, Kysely, Prisma, D1) and Transactional Outbox for Shukoi.",
  "keywords": [
    "shukoi",
    "database",
    "transactions",
    "orm",
    "drizzle",
    "kysely",
    "prisma",
    "cloudflare-d1",
    "outbox",
    "acid"
  ],
  "license": "MIT",
  "author": "shukoilab",
  "homepage": "https://shukoilab.github.io/shukoi/",
  "bugs": "https://github.com/shukoilab/shukoi/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shukoilab/shukoi.git",
    "directory": "packages/db"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "import": "./dist/drizzle.js"
    },
    "./kysely": {
      "types": "./dist/kysely.d.ts",
      "import": "./dist/kysely.js"
    },
    "./prisma": {
      "types": "./dist/prisma.d.ts",
      "import": "./dist/prisma.js"
    },
    "./d1": {
      "types": "./dist/d1.d.ts",
      "import": "./dist/d1.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@shukoi/core": "workspace:*"
  },
  "peerDependencies": {
    "@shukoi/core": "^1.0.3"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
