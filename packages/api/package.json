{
  "name": "@shukoi/api",
  "version": "1.0.1",
  "description": "Hono REST router, stream-bounded chunked reader, OpenAPI 3.1.0 generator, and RFC 9457 Problem Details for Shukoi.",
  "keywords": [
    "shukoi",
    "hono",
    "rest",
    "api",
    "openapi",
    "openapi3",
    "rfc9457",
    "problem-details",
    "stream-reader",
    "http"
  ],
  "license": "MIT",
  "author": "shukoilab",
  "homepage": "https://github.com/shukoilab/shukoi#readme",
  "bugs": "https://github.com/shukoilab/shukoi/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shukoilab/shukoi.git",
    "directory": "packages/api"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shukoi/core": "workspace:*"
  },
  "peerDependencies": {
    "@sinclair/typebox": "^0.34.0",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.0",
    "hono": "^4.7.0"
  }
}
